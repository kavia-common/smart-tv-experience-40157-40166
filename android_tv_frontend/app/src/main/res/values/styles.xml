<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for Android TV using Leanback & Ocean Professional -->
    <style name="AppTheme" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/ocean_background</item>
        <item name="android:colorPrimary">@color/ocean_primary</item>
        <item name="android:colorAccent">@color/ocean_secondary</item>
        <item name="android:navigationBarColor">@color/ocean_background</item>
        <item name="android:statusBarColor">@color/ocean_background</item>

        <!-- TV specific -->
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>

        <!-- Fonts and text colors -->
        <item name="android:textColor">@color/ocean_text</item>
    </style>

    <!-- Card style for focus scaling and outline -->
    <style name="TvCard">
        <item name="android:background">@drawable/bg_card_focusable</item>
    </style>

    <!-- Navigation Item style -->
    <style name="NavItem">
        <item name="android:textColor">@color/ocean_text</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>
</resources>
